  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <AssemblyName>AuthCheck</AssemblyName>
    <RootNamespace>SardaCloud.AuthCheck</RootNamespace>
    <ApplicationIcon>..\..\assets\AuthCheck.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RuntimeIdentifiers>win-x64;win-arm64;win-x86</RuntimeIdentifiers>
  </PropertyGroup>

  <!--
    Published per architecture as one self-contained file, so AuthCheck.exe
    runs on a machine with no .NET installed:
        dotnet publish src\AuthCheck -c Release -r win-arm64
    A plain build stays framework-dependent, so the tests can reference it.
  -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AuthCheck.Tests" />
  </ItemGroup>

</Project>
